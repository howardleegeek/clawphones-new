# ClawPhones Billing Proxy — Environment Variables

# OpenRouter API (single key for all LLM providers)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://clawphones.ai/billing/success
STRIPE_CANCEL_URL=https://clawphones.ai/billing/cancel

# Admin
ADMIN_KEY=your-admin-key-here

# Server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8090
DB_PATH=./data/billing.sqlite3

# Free tier (tokens per day for users with 0 credits)
FREE_DAILY_TOKENS=10000

# Testing
MOCK_MODE=0
